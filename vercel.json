{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "functions": { "api/index.ts": { "maxDuration": 300 } },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 3 * * *" }]
}
