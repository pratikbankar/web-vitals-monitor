# Copy to .env. Everything is optional for local development:
# with no MONGODB_URI an in-memory database is used, and with no PSI_API_KEY audits return sample data.

# MongoDB connection string, including a database name
MONGODB_URI=
# Google PageSpeed Insights API key (free). Needed for real audits.
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
# Required to delete sites or change pinned example sites (header: x-admin-key)
ADMIN_KEY=
# Vercel Cron sends this as "Authorization: Bearer ..." to /api/cron/daily
CRON_SECRET=
